# =============================================================================
# Bank Seal — environment template.
# Copy to `.env.local` and fill in real values. NEVER commit `.env.local`.
# Every variable here is server-only unless prefixed NEXT_PUBLIC_.
# =============================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development

# --- Database (Neon PostgreSQL) --------------------------------------------
# Pooled connection string from the Neon console. Must include `sslmode=require`.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/bankseal?sslmode=require"
# Direct (non-pooled) URL — used by drizzle-kit for migrations.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxxx.region.aws.neon.tech/bankseal?sslmode=require"

# --- Application -----------------------------------------------------------
# Canonical origin. Used for cookie scoping, CSRF origin checks and absolute URLs.
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Cryptography ----------------------------------------------------------
# 32+ random bytes, base64. Generate with: openssl rand -base64 48
# Rotating this invalidates every active session.
SESSION_SECRET="replace-me-with-openssl-rand-base64-48"
# Independent secret for CSRF token signing.
CSRF_SECRET="replace-me-with-openssl-rand-base64-48"

# --- Rate limiting ---------------------------------------------------------
# Optional Upstash Redis. When absent the app falls back to an in-process limiter
# (single-instance only — set these before running more than one server node).
RATE_LIMIT_REDIS_URL=""
RATE_LIMIT_REDIS_TOKEN=""

# --- Observability ---------------------------------------------------------
LOG_LEVEL="info"
